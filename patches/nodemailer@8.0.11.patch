     _upgradeConnection(callback) {
+        // ANYTHING STILL UNREAD WHEN THE UPGRADE BEGINS WAS SENT IN CLEARTEXT, AND MUST NOT BE
+        // ATTRIBUTED TO THE ENCRYPTED SESSION.
+        //
+        // A server may send nothing between its `220` and the client's ClientHello, so a second
+        // response sitting in the queue — or a partial line in the remainder — was written by
+        // somebody who is not the server, or by a server pipelining what it must not pipeline.
+        // Either way it would be read back AFTER the handshake and answered as though it had
+        // arrived encrypted: an attacker who can append to the greeting gets a reply of their
+        // choosing treated as the server's, which for the AUTH stage is the credentials.
+        //
+        // The IMAP client in this program already refuses on exactly this condition. This is the
+        // same refusal for the mail-sending half, which had none.
+        if ((this._responseQueue && this._responseQueue.length) || (this._remainder && this._remainder.length)) {
+            return callback(
+                new Error(
+                    'the server sent more data after its STARTTLS response, so the upgrade is refused: ' +
+                    'those bytes arrived in cleartext and would otherwise be read as part of the ' +
+                    'encrypted session'
+                )
+            );
+        }
+
